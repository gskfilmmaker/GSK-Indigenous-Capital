{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "ES2022"],
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    },
    // Matches packages/ui/tsconfig.json's override: without this, the base
    // config's noPropertyAccessFromIndexSignature forces bracket notation
    // (`styles["hero"]`) for every CSS Modules class reference (see
    // src/css-modules.d.ts).
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
