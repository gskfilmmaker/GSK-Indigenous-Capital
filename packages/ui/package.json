{
  "name": "@gsk/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens/tokens.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
